		"{\"extra\":[{\"text\":\"You pr\"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"obabl\"},{\"text\":\"y don't \"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"h\"},{\"text\":\"ave all the mate\"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"rial\"},{\"text\":\"s yo\"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"u n\"},{\"text\":\"eed. That's where the \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"Decomposer\"},{\"text\":\" comes into play.\"}],\"text\":\"\"}"
