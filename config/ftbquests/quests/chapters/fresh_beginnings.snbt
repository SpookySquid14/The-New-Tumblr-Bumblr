			}]
			tasks: [{
				id: "0F7513BD5A887ABF"
				item: "minecraft:bundle"
				type: "item"
			}]
			title: "Extra Pockets"
			x: 0.5d
			y: -1.0d
		}
		{
			dependencies: ["257AD50176950053"]
			description: ["There are two possible \"upgrades\" for the furnace, each pertaining to a certain function. The &6&oBlast Furnace&r is one of these upgrades, pertaining to smelting down ores and metals. With the Blast Furnace, &6&oany raw metals or ores you put in will be processed much quicker than a typical furnace&r, but you will not be able to put any other items in, such as food. For that, you need the other option."]
			id: "0A8BB0E2C6DB515A"
