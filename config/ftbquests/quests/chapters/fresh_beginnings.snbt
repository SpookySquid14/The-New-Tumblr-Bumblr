	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"[\"\",{\"text\":\"Welcome, traveler. I do not know your name, but neither do you mine. What matters is that we've met, talked... understood one another.\",\"font\": \"alt\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"Welcome, traveler. I do not know your name, but neither do you mine. What matters is that we've met, talked... understood one another.\"}},{\"text\":\"\\n\\n\",\"font\": \"alt\"},{\"text\":\"This world is full of wonders, but also danger. Many gears move in the clockwork of reality, and time is something nobody can escape. So the question is, what will you do with yours?\",\"font\": \"alt\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"This world is full of wonders, but also danger. Many gears move in the clockwork of reality, and time is something nobody can escape. So the question is, what will you do with yours?\"}},{\"text\":\"\\n\\n\",\"font\": \"alt\"},{\"text\":\"Within the contents of this book are a collection of people's notes, their journeys, and for some, their life's work. I'm certain it will prove useful to you.\",\"font\": \"alt\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"Within the contents of this book are a collection of people's notes, their journeys, and for some, their life's work. I'm certain it will prove useful to you.\"}},{\"text\":\"\\n\\n\",\"font\": \"alt\"},{\"text\":\"Ah, but be not afraid if you lose this book. Its contents will always be accessible through your inventory.\",\"font\": \"alt\",\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"Ah, but be not afraid if you lose this book. Its contents will always be accessible through your inventory.\"}}]"
				"{image:tumblrbumblr:textures/quests/quest-book.png width:156 height:90 align:center}"
				""
				"Now, go forth, and carve your tale."
			]
			icon: "ftbquests:book"
