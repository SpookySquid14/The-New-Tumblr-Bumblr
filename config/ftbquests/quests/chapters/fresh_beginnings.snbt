				"[\"\",{\"text\":\"You want to get stronger, don't you? In that case, \",\"font\":\"alt\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"You want to get stronger, don't you? In that case, look to the Skill Tree tab in your inventory, or press the assigned keybind (Default K).\"}},{\"font\":\"alt\",\"text\":\"look to the Skill Tree tab in your inventory\",\"color\":\"gold\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"You want to get stronger, don't you? In that case, look to the Skill Tree tab in your inventory, or press the assigned keybind (Default K).\"}},{\"text\":\", or press the assigned keybind (Default K).\",\"font\":\"alt\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"You want to get stronger, don't you? In that case, look to the Skill Tree tab in your inventory, or press the assigned keybind (Default K).\"}}]"
				"{image:tumblrbumblr:textures/quests/skill-tree-tab.png width:150 height:90 align:center}"
				"{@pagebreak}"
