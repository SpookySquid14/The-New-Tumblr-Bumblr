			title: "The Berry's Blowing Up"
			x: -1.0d
			y: -2.5d
		}
		{
			dependencies: ["0BB8DE1AF9032136"]
			description: [
				"{\"extra\":[{\"text\":\"Aside from a few decorative blocks, Bloomberries can be used for one particular, beautiful thing. \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"The Primordial Infestation effect\"},{\"text\":\". Using these berries for potions or a serum will grant this wonderful boon. Under its effect, you'll speak the Primordial Tongue. It will come naturally to you. Ah, a true gift~\"}],\"text\":\"\"}"
				"{\"extra\":[{\"text\":\"Even more, your death \"},{\"obfuscated\":true,\"text\":\"will spread the flesh further\"},{\"text\":\". Even deceased, you will continue to breathe new life.\"}],\"text\":\"\"}"
			]
			id: "57100F16C9395F28"
