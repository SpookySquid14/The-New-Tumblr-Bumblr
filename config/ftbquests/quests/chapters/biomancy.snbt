			dependencies: ["306086EE9B34A8CC"]
			description: [
				"{\"extra\":[{\"text\":\"While watc\"},{\"obfuscated\":true,\"text\":\"hing the fles\"},{\"text\":\"h spread, did you come acr\"},{\"obfuscated\":true,\"text\":\"oss an\"},{\"text\":\"y berries? \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"Bloomberries form near outer walls of flesh\"},{\"text\":\". They c\"},{\"obfuscated\":true,\"text\":\"an be p\"},{\"text\":\"icked and then consumed for rando\"},{\"obfuscated\":true,\"text\":\"m po\"},{\"text\":\"tion effects. Alternativ\"},{\"obfuscated\":true,\"text\":\"ely, y\"},{\"text\":\"ou can let a \"},{\"obfuscated\":true,\"text\":\"fully grown bloo\"},{\"text\":\"mberry continue growing before it'\"},{\"obfuscated\":true,\"text\":\"s lau\"},{\"text\":\"nched into the sky. \"},{\"obfuscated\":true,\"text\":\"After tr\"},{\"text\":\"aveling a bit, \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"they'll explode into malignant veins\"},{\"text\":\", continuing t\"},{\"obfuscated\":true,\"text\":\"he spre\"},{\"text\":\"ad of the flesh.\"}],\"text\":\"\"}"
				"{image:modpack:textures/bloomberry.png width:100 height:100 align:center}"
			]
			id: "0BB8DE1AF9032136"
