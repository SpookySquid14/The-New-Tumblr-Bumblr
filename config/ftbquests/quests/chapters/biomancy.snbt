		{
			dependencies: ["7B7F34E2C34E28FA"]
			description: [
				"{\"extra\":[{\"text\":\"So, you \"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"prob\"},{\"text\":\"ably don't want to b\"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"e const\"},{\"text\":\"antly giving the ma\"},{\"font\":\"biomancy:caro_invitica\",\"text\":\"chines meat fo\"},{\"text\":\"r nutrients, right? Well, you have the Bio-Forge now, so you can make a \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"Digester\"},{\"text\":\".\"}],\"text\":\"\"}"
				"{\"extra\":[{\"text\":\"The Digester\"},{\"obfuscated\":true,\"text\":\" is ra\"},{\"text\":\"ther simple. You put any\"},{\"obfuscated\":true,\"text\":\" sort of \"},{\"text\":\"organic material like meat or plants inside, and it'll convert them into \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"Nutrient Paste\"},{\"text\":\". This is a great sou\"},{\"obfuscated\":true,\"text\":\"rce of n\"},{\"text\":\"utrients, and\"},{\"obfuscated\":true,\"text\":\" when compr\"},{\"text\":\"essed into \"},{\"italic\":true,\"color\":\"gold\",\"text\":\"Nutrient Bars\"},{\"text\":\", can\"},{\"obfuscated\":true,\"text\":\" be a\"},{\"text\":\" very good option for food.\"}],\"text\":\"\"}"
