		}
		{
			dependencies: ["15ACD993630984F4"]
			description: ["Dragons are powerful creatures that come in many shapes and forms. Saint's Dragons aims to add variety within these powerful beings. Unlike other dragon based mods, dragons do not spawn in nests or structures. They are instead found in the wild, roaming, or remaining in their territories. While most are neutral, some prpesent a dangerous threat, so be on guard, and be prepared."]
			hide_until_deps_complete: true
			id: "4D54B17785EC3EC0"
			rewards: [{
				amount: 100L
				currency: "eternalcurrencies:ancientcoins"
