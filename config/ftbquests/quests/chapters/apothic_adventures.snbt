					type: "item"
				}
			]
			title: "Augmentation's Peak"
			x: 0.5d
			y: -5.0d
		}
		{
			dependencies: ["43AE403E62C96F66"]
			description: [
				"If you want to get the most out of your gems, or if you simply have duplicates, you may want to look at the &o&6Gem Cutting Table&r. When using it, you can increase a Gem's rarity, provided you have the necessary materials."
				"While the exact materials will always be shown by putting your gem in the middle slot, a good rule of thumb is that &6&oyou'll need a second copy of the gem, the rarity material of the rarity you are upgrading it to, and gem dust&r."
				"{image:tumblrbumblr:textures/quests/gem-cutting-table.png width:160 height:90 align:center}"
			]
			id: "47532F7269B287FF"
			rewards: [{
				amount: 100L
				currency: "eternalcurrencies:ancientcoins"
				id: "0B7C0B63D746F716"
