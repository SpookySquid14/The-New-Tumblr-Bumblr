	quests: [
		{
			dependencies: ["15ACD993630984F4"]
			description: ["They say that long, long ago, the gods grew bored with the world they'd created. In search of something that may entertain them, the god of the storm transformed the deepest of the oceans covered with ice into a maze. Now a truly cursed place where those who venture in never return, it's said that even the water itself freezes you down to the very bone. Perhaps that's why so many wear leather."]
			hide_until_deps_complete: true
			id: "4A47FB945C0C4886"
			rewards: [{
				amount: 100L
				currency: "eternalcurrencies:ancientcoins"
				id: "3655C33BD3A1D3E5"
				ignore_reward_blocking: true
				type: "eternalcurrencies:currency"
			}]
			tasks: [{
				biome: "#aquamirae:ice_maze"
				icon: "minecraft:packed_ice"
				id: "6DE19F82A1C9D371"
				title: "Find an Ice Maze"
				type: "biome"
			}]
			title: "Legends Carved in Ice"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["4A47FB945C0C4886"]
			description: ["To any mad enough to enter the graveyard of frost, heed this warning. As the oceans freeze over, and the gods play with its shape, its form, combat the cold with leather, or else meet a sub-zero end like the pirates before thee."]
			id: "43F02218C2BBA0ED"
			tasks: [{
