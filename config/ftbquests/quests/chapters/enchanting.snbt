		{
			dependencies: ["15ACD993630984F4"]
			description: ["Cobwebs can be placed in an Anvil with an enchanted item to remove its enchantments. Prismatic Cobwebs are crafted with prismarine shards, and do the same for curses."]
			hide_until_deps_complete: true
