		{
			description: [
				"kane@remus:~$ cat cry-nrg.jv"
				"------------------------------"
				"At the site of a large meteor, researchers were able to extract crystals that seemed to glow with energy. Large samples have been taken, and more continue to as more meteors are found."
			]
			id: "3607F8E9C8F3C7FF"
