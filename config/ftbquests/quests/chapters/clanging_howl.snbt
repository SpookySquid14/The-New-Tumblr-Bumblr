				title: "Encounter a Flesh Maiden"
				to_observe: "clanginghowl:flesh_maiden"
				type: "observation"
			}]
			title: "ch-003 \"Flesh Maiden\""
			x: -5.5d
			y: -3.0d
		}
		{
			description: [
				"bishop@romulus:~$ cat ext_steel.jv"
				"------------------------------"
				"___Report Date: 1982-06-25___"
				"Unknown metal taken from sites of meteor showers alongside rocks. Analysis of small samples reveal a structure similar in shape to that of steel. Properties yet to be fully analyzed. A larger sample may be required."
			]
			id: "74B74B738FDAA691"
			tasks: [{
