		}
		{
			dependencies: ["3607F8E9C8F3C7FF"]
			description: [
				"kane@remus:~$ cat crys_gen.jv"
				"------------------------------"
				"After numerous failed attempts, researchers succeeded in cryogenically creating a renewable source of the energy crystals required to create many of the newer creations. The area around the machine was deathly cold, however, and required careful extraction. This has opened up a new realm of possibilities."
			]
			id: "03D9CFFF0388FBE2"
