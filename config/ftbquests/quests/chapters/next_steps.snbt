						value: "smallships:ships"
					}
				}
				type: "item"
			}]
			title: "To Sail The Seas"
			x: -5.5d
			y: -1.0d
		}
		{
			dependencies: ["3A6E403F44FFE7AA"]
			description: ["When roaming the frozen tundra, and especially high in the mountains, Powder Snow can be a deadly trap. Without specialized gear or leather boots, one will find themselves sinking in its cold grip, and quickly feel their temperature drop. It's best to get out fast unless you wish to freeze to death."]
