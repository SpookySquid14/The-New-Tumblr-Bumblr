		{
			dependencies: ["4537DD077CD404BF"]
			description: ["The Fleshkin Chest is like a regular chest for the most part, though it features less storage, only holding 42 stacks of items. Where it differs from a regular chest, however, is in its &odefense mechanism&r. You see, by default, &o&6only the player who placed the chest down will be able to open it. All other players will be attacked, instead. A player can be given permission by right clicking the chest with said player's tier 3 essence&r."]
			hide_dependency_lines: true
			hide_until_deps_complete: true
			id: "58697C4CF815054A"
			tasks: [{
				id: "2A71E76077D2FB4D"
				item: "biomancy:fleshkin_chest"
				type: "item"
			}]
			x: 3.5d
			y: 1.0d
		}
		{
			dependencies: ["4537DD077CD404BF"]
			description: ["The Maw Hopper acts mostly like its traditional counterpart, but with some key differences. The first is that, unlike a regular hopper, &6&othe maw hopper will transport up to 16 of a single item at a time&r. The other difference is that, unlike a regular hopper, the maw hopper can be connected to elongate it and move in different directions, much like a pipe."]
			hide_dependency_lines: true
			hide_until_deps_complete: true
			id: "396D173C835EC97C"
